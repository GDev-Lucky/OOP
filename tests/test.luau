-- Generic Inheritance Rebinding


type GenericParent<T> = Class<{
    ___generics: Generic<T>,

    parentValue: Var<T>,

    parentClone: () -> GenericObject,
    parentExplicitSame: () -> GenericObject<T>,
    parentAsString: () -> GenericObject<string>,
}>


type GenericChild<T> = Class<
    {
        ___generics: Generic<T>,

        childValue: Var<T>,
    },
    GenericParent<T>
>


type NumberChild = GenericChild<number>
type NumberChildObject = ObjectOf<NumberChild>

local numberChild: NumberChildObject = any()

local inheritedClone = numberChild:parentClone()
local _inheritedCloneParentValue: number = inheritedClone.parentValue
local _inheritedCloneChildValue: number = inheritedClone.childValue

local inheritedExplicitSame = numberChild:parentExplicitSame()
local _inheritedExplicitParentValue: number = inheritedExplicitSame.parentValue
local _inheritedExplicitChildValue: number = inheritedExplicitSame.childValue

local inheritedStringChild = numberChild:parentAsString()
local _inheritedStringParentValue: string = inheritedStringChild.parentValue
local _inheritedStringChildValue: string = inheritedStringChild.childValue


-- Generic Interface Rebinding


type GenericInterface<T> = oop.Interface<{
    ___generics: Generic<T>,

    interfaceValue: Var<T>,
    interfaceClone: () -> GenericObject<T>,
}>


type GenericInterfaceClass<T> = Class<
    {
        ___generics: Generic<T>,

        localValue: Var<T>,
    },
    GenericInterface<T>
>


