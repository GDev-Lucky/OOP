-- Three Generics


type GenericTriple<A, B, C> = Class<{
    ___generics: Generic<A, B, C>,

    first: A,
    second: B,
    third: C,

    rotate: () -> GenericObject<C, A, B>,
    reverse: () -> GenericObject<C, B, A>,
}>


