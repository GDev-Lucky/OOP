-- Single Generic


type GenericBox<T> = Class<{
    ___generics: Generic<T>,

    new: Constructor<(value: T) -> ()>,

    value: Var<T>,
    maybe: T?,
    unionValue: T | boolean,

    protectedValue: Protected<Var<T>>,
    privateValue: Private<Var<T>>,

    payload: {
        direct: T,
        array: { T },
        dictionary: { [string]: T },
        transform: (T) -> T,
    },

    frozen: Immut<{
        value: T,
        current: GenericObject<>,
        text: GenericObject<string>,
    }>,

    next: Var<GenericObject<>?>,

    get: () -> T,
    identity: <U>(U, T) -> U,

    clone: () -> GenericObject<>,
    explicitSame: () -> GenericObject<T>,

    asString: () -> GenericObject<string>,
    asNumber: () -> GenericObject<number>,
    asUnknown: () -> GenericObject<unknown>,
    asUnion: () -> GenericObject<string | number>,
    asOptional: () -> GenericObject<string?>,
    asTable: () -> GenericObject<{ id: number }>,
    asFunction: () -> GenericObject<(number) -> string>,

    consumeString: (GenericObject<string>) -> GenericObject<number>,

    selfAsString: Protected<() -> GenericSelf<string>>,

    classAsString: Static<() -> GenericClassType<string>>,
    implAsString: Private<Static<() -> GenericImpl<string>>>,

    nestedReferences: {
        current: GenericObject<>,
        text: GenericObject<string>,
        maybeNumber: GenericObject<number>?,
        list: { GenericObject<string> },
        dictionary: { [string]: GenericObject<number> },
    },
}>


