-- Generic Reference Expected Errors


-- Missing Generic Declaration For Explicit Specialization


type MissingGenericDeclaration<T> = Class<{
    value: T,
    bad: () -> GenericObject<T>,
}>


-- Invalid Generic Declaration Type


type InvalidGenericDeclarationType<T> = Class<{
    ___generics: T,
    value: T,
}>


-- Generic Declaration Must Contain Generic Types


type InvalidConcreteGenericDeclaration = Class<{
    ___generics: Generic<number>,
    value: number,
}>


-- Generic Reference Count Too Small


type InvalidGenericCountSmall<A, B> = Class<{
    ___generics: Generic<A, B>,
    bad: () -> GenericObject<A>,
}>


-- Generic Reference Count Too Large


type InvalidGenericCountLarge<A> = Class<{
    ___generics: Generic<A>,
    bad: () -> GenericObject<A, string>,
}>


-- Variadic Generic Packs Are Not Supported


type InvalidVariadicGenericDeclaration<A...> = Class<{
    ___generics: Generic<A...>,
    value: number,
}>


